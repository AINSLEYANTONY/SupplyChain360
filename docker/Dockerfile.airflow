FROM apache/airflow:3.1.8-python3.11

USER root
# Java for Spark (try 17, fall back to 21 if this Debian version has no 17)
RUN apt-get update \
 && (apt-get install -y --no-install-recommends openjdk-17-jre-headless \
     || apt-get install -y --no-install-recommends openjdk-21-jre-headless) \
 && apt-get install -y --no-install-recommends curl procps \
 && rm -rf /var/lib/apt/lists/*

USER airflow
RUN pip install --no-cache-dir pyspark==3.5.3 pandas pyarrow boto3 python-dotenv

# Jars so Spark can talk to MinIO (s3a://) and PostgreSQL
RUN SPARK_JARS=$(python -c "import pyspark, os; print(os.path.join(os.path.dirname(pyspark.__file__), 'jars'))") && \
    curl -fsSL -o $SPARK_JARS/hadoop-aws-3.3.4.jar https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl -fsSL -o $SPARK_JARS/aws-java-sdk-bundle-1.12.262.jar https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar && \
    curl -fsSL -o $SPARK_JARS/postgresql-42.7.4.jar https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar

    
# dbt in its own virtual environment (keeps its libraries away from Airflow's)
RUN python -m venv /home/airflow/dbt_venv \
 && /home/airflow/dbt_venv/bin/pip install --no-cache-dir dbt-core==1.11.11 dbt-postgres==1.10.0